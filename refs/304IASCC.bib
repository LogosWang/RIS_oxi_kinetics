	keywords = {*Skin, *Wearable Electronic Devices, Dimethylpolysiloxanes, Electric Conductivity, Gold/*chemistry, Humans, Nanowires/*chemistry, Nylons, Pressure, Stress, Mechanical, electronic skin, electronic tattoos, gold nanowires, programmable cracking},
}

