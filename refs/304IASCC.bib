@article{sharma2020review,
	title = {A review on biomacromolecular hydrogel classification and its applications},
	volume = {162},
	issn = {1879-0003 (Electronic) 0141-8130 (Linking)},
	doi = {10.1016/j.ijbiomac.2020.06.110},
	abstract = {Biomacromolecular hydrogels are consist of 3D networks, which have a tendency to absorb large amount of water without dissolving in aqueous medium. Such inherent feature of the hydrogels facilitates the scientific research interest to a dominating path in extending their potential in various fields. In recent years, development of responsive hydrogels has been observed in various field. Self-healing property of the hydrogel attracts more attention in different areas because this property increases the lifespan of the polymeric material. By keeping all these views in mind, the present review focuses on the classification of biomacromolecular hydrogels, methods and its applications. The polymeric material exhibiting multi-responsive properties such as swelling, {pH} responsive, mechanically strong, self-healing, flexible plays vital role in different applications. In addition, this review summarizes the classification of hydrogels, based on their chemical and physical state along with the various applications. At the end, a brief outlook also presented the future aspects of the hydrogels.},
