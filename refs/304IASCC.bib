@article{han2023hybrid,
	title = {Hybrid Fabrication of Prestrain-Locked Acrylic Dielectric Elastomer Thin Films and Multilayer Stacks},
	volume = {44},
	issn = {1521-3927 (Electronic) 1022-1336 (Linking)},
	doi = {10.1002/marc.202300160},
	abstract = {Dielectric elastomers based on commercial acrylic dielectric elastomers ({VHB} adhesive films) are widely investigated for soft actuators due to their large electrically driven actuation strain and high work density. However, the {VHB} films require prestretching to overcome electromechanical instability, which adds fabrication complexity. In addition, their high viscoelasticity leads to a low response speed. Interpenetrated polymer networks ({IPNs}) are developed to lock the prestrain in {VHB} films, resulting in free-standing films that are capable of large-strain actuation. In this work, a prestrain-locked high-performance dielectric elastomer thin film ({VHB}-{IPN}-P) by introducing 1,6-hexanediol diacrylate to create an {IPN} in the {VHB} network and a plasticizer to enhance the actuation speed is reported. {VHB}-{IPN}-P based actuators exhibit stable actuation at 60\% strain up to 10 Hz and reach a peak energy density of 102 J kg(-)(1) . In addition, a hybrid process is also developed for the fabrication of multilayer stacks of {VHB}-{IPN}-P with strong inter-layer bonding and structural integrity. Four-layer stacks fabricated preserve the strain and energy density of single-layer {VHB}-{IPN}-P films but with linearly scaled force and work output.},
	pages = {e2300160},
	number = {15},
	journaltitle = {Macromol Rapid Commun},
	author = {Han, Z. and Peng, Z. and Guo, Y. and Wang, H. and Plamthottam, R. and Pei, Q.},
	date = {2023-08},
	note = {{EndNote} Record Number: 154},
	keywords = {*Elastomers/chemistry, *Polymers/chemistry, Electricity, dielectric elastomers, fabrications, interpenetrated polymer networks, multilayers, plasticizers, soft actuators},
}

@inproceedings{t.n.thihuong2015static,
	title = {Static hand gesture recognition for vietnamese sign language ({VSL}) using principle components analysis},
	doi = {10.1109/ComManTel.2015.7394275},
	abstract = {Nowadays, hand gesture is one of main considerations for hearing impaired people because they use sign language to communicate with each other and to normal people. In general, the normal people have difficulties with sign language therefore they need an interpreter supporting communication. Then the automatic hand gesture recognition system is needed to help hearing impaired people integrating into social community. In technical, sign language is comprehensive problem because the complexity of visual analysis of hand gesture and the highly structured nature of sign language. This paper proposes a system using Principle Component Analysis ({PCA}) to recognize hand gestures for Vietnamese Sign Language ({VSL}) in uniform background and evaluate the effectiveness of methods using Euclidean and Mahalanobis distance in classification. The experimental results show that the proposed method obtains a high success rate in recognition.},
