@article{RN377,
   author = {Zhou, X. and He, S. and Marian, J.},
   title = {Vacancy Energetics and Diffusivities in the Equiatomic Multielement Nb-Mo-Ta-W Alloy},
   journal = {Materials (Basel)},
   volume = {15},
   number = {15},
   note = {Zhou, Xinran
He, Sicong
Marian, Jaime
eng
DMR- 284 1611342/National Science Foundation/
Switzerland
Materials (Basel). 2022 Aug 8;15(15):5468. doi: 10.3390/ma15155468.},
   abstract = {In this work, we study vacancy energetics in the equiatomic Nb-Mo-Ta-W alloy, especially vacancy formation and migration energies, using molecular statics calculations based on a spectral neighbor analysis potential specifically developed for Nb-Mo-Ta-W. We consider vacancy properties in bulk environments as well as near edge dislocation cores, including the effect of short-range order (SRO) by preparing supercells through Metropolis Monte-Carlo relaxations and temperature on the calculation. The nudged elastic band (NEB) method is applied to study vacancy migration energies. Our results show that both vacancy formation energies and vacancy migration energies are statistically distributed with a wide spread, on the order of 1.0 eV in some cases, and display a noticeable dependence on SRO. We find that, in some cases, vacancies can form with very low energies at edge dislocation cores, from which we hypothesize the formation of stable 'superjogs' on edge dislocation lines. Moreover, the large spread in vacancy formation energies results in an asymmetric thermal sampling of the formation energy distribution towards lower values. This gives rise to effective vacancy formation energies that are noticeably lower than the distribution averages. We study the effect that this phenomenon has on the vacancy diffusivity in the alloy and discuss the implications of our findings on the structural features of Nb-Mo-Ta-W.},
   keywords = {Nb-Ta-Mo-W
diffusivity
molecular statics
short range order
vacancy energetics},
   ISSN = {1996-1944 (Print)
1996-1944 (Electronic)
1996-1944 (Linking)},
   DOI = {10.3390/ma15155468},
   url = {https://www.ncbi.nlm.nih.gov/pubmed/35955403},
   year = {2022},
   type = {期刊文献}
}

